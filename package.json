{
  "name": "secret-me",
  "version": "0.1.0",
  "private": false,
  "description": "Flags secrets, tokens and passwords before they leave your machine: a gitleaks wrapper for the CLI, a pre-commit hook, a GitHub Action and a Claude Code plugin",
  "author": "Kevin de Jong",
  "license": "MIT",
  "homepage": "https://github.com/dev-build-deploy/secret-me",
  "keywords": [
    "github",
    "action",
    "secrets",
    "gitleaks",
    "pre-commit",
    "security"
  ],
  "bugs": {
    "url": "https://github.com/dev-build-deploy/secret-me/issues"
  },
  "scripts": {
    "build": "run-p build:*",
    "build:cli": "ncc build -o lib/cli src/entrypoints/cli.ts",
    "build:action": "ncc build -o lib/action src/entrypoints/action.ts",
    "build:plugin": "ncc build -o claude-plugin/bundle src/entrypoints/cli.ts",
    "test": "jest --coverage",
    "lint": "eslint src test/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "bin": {
    "secret-me": "./bin/secret-me"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^6.0.1",
    "@dev-build-deploy/sarif-it": "^0.2.1",
    "commander": "^12.1.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
