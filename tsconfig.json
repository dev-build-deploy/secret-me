{
  "include": ["src/", "test/*.ts"],
  "compileOnSave": false,
  "compilerOptions": {
    "lib": ["es2024"],
    "types": ["node", "jest"],
    "module": "nodenext",
    "target": "es2024",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "isolatedModules": true
  },
  "exclude": ["node_modules"]
}
